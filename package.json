{
  "name": "@e9n/pi-bridge",
  "version": "0.3.0",
  "description": "Multi-platform messaging bridge for pi — bidirectional channels for Telegram, Slack, Discord, iMessage, and more",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Espen Nilsen <hi@e9n.dev>",
  "scripts": {
    "test": "node --import=tsx --test src/**/__tests__/*.test.ts",
